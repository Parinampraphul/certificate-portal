# SQL Server (TrustServerCertificate=yes is added automatically if missing)
DATABASE_URL=mssql+pyodbc://USER:PASSWORD@localhost/GuildCertificates?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
# Windows authentication alternative:
# DATABASE_URL=mssql+pyodbc://@localhost/GuildCertificates?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Public URL used when building the shareable links
BASE_URL=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000
DEFAULT_LINK_HOURS=48
